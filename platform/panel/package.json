{
  "name": "@stg/panel",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 7510 --strictPort",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "gen": "cd .. && spacetime generate --lang typescript --out-dir panel/src/bindings --module-path games/template/spacetimedb --no-config --yes"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.7",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "spacetimedb": "2.12.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "vite": "^7.1.0"
  }
}
